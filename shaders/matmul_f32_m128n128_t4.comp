#version 460
// 128x128 output tile with a SMALLER per-thread tile (TM=4 TN=8) and a
// larger workgroup (512 threads).  Same shared-mem footprint as the
// 128x128 large kernel but doubles the warps-per-WG count for better
// latency hiding when the matrix is large enough to keep all 46 SMs
// busy.

#define BM 128u
#define BN 128u
#define BK  32u
#define TM   4u
#define TN   8u
#define TN_RAW 8

#include "matmul_kernel.glsl"
