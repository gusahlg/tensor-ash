#version 460
// 256x64 output tile with BK=32.  Larger tile in the M direction for
// tall problems where M >> N. Per-WG shared = 256*32*4 + 32*64*4 =
// 40 KB, fits the 48 KB Vulkan limit.

#define BM 256u
#define BN  64u
#define BK  32u
#define TM  16u
#define TN   4u
#define TN_RAW 4

#include "matmul_kernel.glsl"
