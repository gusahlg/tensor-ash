#version 460
// =====================================================================
//  VK_NV_cuda_kernel_launch ordering probe — the Vulkan twin of
//  ptx/probe.cu:probe_affine.
//
//      dst[i] = src[i] * mul + add      (wrapping u32 arithmetic)
//
//  Walks the buffer in REVERSE order (workgroup 0 handles the LAST
//  elements) while the CUDA twin walks it forward, so a Vulkan<->CUDA
//  producer/consumer pair whose barrier does not order the two races
//  on exactly the elements the producer writes last.  Grid-stride loop,
//  so any dispatch size covers any n.  Used only by `ml_bench ptx`.
// =====================================================================

#extension GL_EXT_buffer_reference         : require
#extension GL_EXT_buffer_reference2        : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256) in;

layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer U32ReadOnly {
    uint v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) restrict writeonly buffer U32WriteOnly {
    uint v[];
};

layout(push_constant) uniform PC {
    U32ReadOnly  src;
    U32WriteOnly dst;
    uint n;
    uint mul;
    uint add;
    uint _pad;
} pc;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride) {
        const uint j = pc.n - 1u - i;
        pc.dst.v[j] = pc.src.v[j] * pc.mul + pc.add;
    }
}
