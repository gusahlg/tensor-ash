#version 460
// 256x256/BK=8 Strassen-style matmul.  One workgroup = one Strassen
// application = one 256x256 output tile.  See the kernel header for the
// design rationale.

#define BM 256u
#define BN 256u
#define BK   8u
// Per-quadrant sub-tile = 128x128, per-thread mini-tile = 4x4.  Each
// thread owns one 4x4 patch in EACH of the 4 C quadrants.
#define BM_Q 128u
#define BN_Q 128u
#define TM    4u
#define TN    4u

#include "matmul_strassen_kernel.glsl"
