#version 460
// Token-embedding row gather with a device-side token id: reads the
// u32 token from a result cell (typically the argmax kernel's output —
// GPU-to-GPU feedback, no host round trip), then copies row `token` of
// the [vocab, embd] embedding table into a [embd] f32 output.  The
// table may be f16 (GGUF token_embd) or f32; f16 widens exactly.
//
// The token id is clamped to vocab-1 so a garbage cell cannot read out
// of bounds; a chained argmax over vocab logits is always in range.

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer F32ReadOnly {
    float v[];
};
layout(buffer_reference, std430, buffer_reference_align = 2) restrict readonly buffer F16ReadOnly {
    float16_t v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) restrict readonly buffer U32ReadOnly {
    uint v[];
};
layout(buffer_reference, std430, buffer_reference_align = 4) restrict buffer F32ReadWrite {
    float v[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) restrict readonly buffer F32V4ReadOnly {
    vec4 v[];
};
layout(buffer_reference, std430, buffer_reference_align = 16) restrict writeonly buffer F32V4Write {
    vec4 v[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) restrict readonly buffer F16V4ReadOnly {
    f16vec4 v[];
};
layout(buffer_reference, std430, buffer_reference_align = 8) restrict writeonly buffer F16V4Write {
    f16vec4 v[];
};

layout(buffer_reference, std430, buffer_reference_align = 2) restrict writeonly buffer F16WriteOut {
    float16_t v[];
};

layout(push_constant) uniform PC {
    uint embd;
    uint vocab;
    uint table_f16;
    uint n_tokens;
    uint out_f16;
    uint _pad;
    U32ReadOnly token_ptr;
    uint64_t table_ptr;
    uint64_t out_ptr;
} pc;

void main() {
    const uint i4 = gl_GlobalInvocationID.x;
    const uint t = gl_WorkGroupID.y;
    const uint i = i4 * 4u;
    if (t >= pc.n_tokens || i >= pc.embd) return;
    const uint token = min(pc.token_ptr.v[t], pc.vocab - 1u);
    const uint idx = token * pc.embd + i;
    const uint o = t * pc.embd + i;
    // Vec4 loads need embd % 4 == 0 so token*embd stays aligned.
    if (i + 4u <= pc.embd && (pc.embd & 3u) == 0u) {
        const vec4 value = pc.table_f16 != 0u
            ? vec4(F16V4ReadOnly(pc.table_ptr).v[idx >> 2u])
            : F32V4ReadOnly(pc.table_ptr).v[idx >> 2u];
        if (pc.out_f16 != 0u) {
            F16V4Write(pc.out_ptr).v[o >> 2u] = f16vec4(value);
        } else {
            F32V4Write(pc.out_ptr).v[o >> 2u] = value;
        }
        return;
    }
    for (uint k = 0u; k < 4u; ++k) {
        if (i + k >= pc.embd) break;
        const float value = pc.table_f16 != 0u
            ? float(F16ReadOnly(pc.table_ptr).v[idx + k])
            : F32ReadOnly(pc.table_ptr).v[idx + k];
        if (pc.out_f16 != 0u) {
            F16WriteOut(pc.out_ptr).v[o + k] = float16_t(value);
        } else {
            F32ReadWrite(pc.out_ptr).v[o + k] = value;
        }
    }
}
